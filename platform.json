{
  "name": "nxps32k",
  "version": "1.0.0",
  "title": "NXP S32K Series",
  "description": "PlatformIO platform for NXP S32K Automotive MCUs with Bare-metal and EduFramework support",
  "url": "https://github.com/QuangTM15/platform-nxps32k",
  "homepage": "https://github.com/QuangTM15/platform-nxps32k",
  "license": "MIT",
  "engines": {
    "platformio": "^6.0.0"
  },
  "frameworks": {
    "baremetal": {
      "package": "framework-s32k144-baremetal",
      "script": "builder/frameworks/baremetal.py",
      "description": "NXP S32K144 bare-metal startup, linker and device support"
    },
    "eduframework": {
      "package": "framework-eduframework-s32k144",
      "script": "builder/frameworks/eduframework.py",
      "description": "EduFramework Arduino-style framework for NXP S32K144 / MaaZEDU"
    }
  },
  "packages": {
    "toolchain-gccarmnoneeabi": {
      "type": "toolchain",
      "owner": "platformio",
      "version": "~1.90201.0"
    },
    "tool-jlink": {
      "type": "uploader",
      "owner": "platformio"
    },
    "framework-s32k144-baremetal": {
      "type": "framework",
      "optional": true,
      "version": "https://github.com/tranhungtdh06/framework_s32k144_baremetal.git"
    },
    "framework-eduframework-s32k144": {
      "type": "framework",
      "optional": true,
      "version": "https://github.com/QuangTM15/s32k144-edu-framework/releases/download/v0.2.0/framework-eduframework-s32k144-v0.2.0.zip"
    }
  }
}