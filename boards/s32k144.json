{
  "build": {
    "core": "s32k",
    "cpu": "cortex-m4",
    "mcu": "s32k144",
    "f_cpu": "80000000L"
  },

  "debug": {
    "default_tools": [
      "jlink"
    ],
    "jlink_device": "S32K144",
    "svd_path": "cmsis/S32K144.svd",
    "tools": {
      "jlink": {
        "server": {
          "package": "tool-jlink",
          "executable": "JLinkGDBServerCL.exe",
          "arguments": [
            "-singlerun",
            "-if", "SWD",
            "-select", "USB",
            "-device", "S32K144",
            "-speed", "4000",
            "-port", "2331"
          ]
        },
        "init_break": "tbreak main"
      }
    }
  },

  "frameworks": [
    "baremetal",
    "eduframework"
  ],

  "name": "MaaZEDU S32K144",

  "upload": {
    "maximum_ram_size": 65536,
    "maximum_size": 524288,
    "protocol": "jlink",
    "protocols": [
      "jlink"
    ]
  },

  "url": "https://github.com/QuangTM15/platform-nxps32k",

  "vendor": "MaaZEDU"
}